* text=auto
*.java text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.py text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.png binary
*.nbt binary
*.jar binary
# Release manifests compare resource bytes, including their original line endings.
src/main/resources/** -text
migration/** -text
validation/** -text
# Treat preserved CRLF as an end-of-line marker during whitespace checks.
src/main/resources/** whitespace=cr-at-eol
migration/** whitespace=cr-at-eol
validation/** whitespace=cr-at-eol
